  if (session && typeof session.topic === "string" && session.topic) return session.topic;
  if (!session) return "";

  const topicByIntent = {
    pythonCode: "python", pythonInfo: "python", htmlCode: "html",
    ai: "ai", emotion: "emotion", identity: "identity"
  };

  for (const message of [...session.messages].reverse()) {
    if (message.role !== "user") continue;
    const topic = topicByIntent[classify(message.text)];
    if (topic) return topic;
  }
  return "";
}

