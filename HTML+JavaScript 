async function copyMessageText(text) {
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
    } else {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      const copied = document.execCommand("copy");
      textarea.remove();
      if (!copied) throw new Error("Clipboard unavailable");
    }
    return true;
  } catch {
    return false;
  }
}

function renderChat() {
  const chat = $("chat");
  chat.replaceChildren();

  const session = currentSession();
  if (!session) {
    updateChatSize();
    return;
  }

  if (!session.messages.length) {
    const landing = document.createElement("div");
    landing.className = "landing-card";
    const title = document.createElement("strong");
    title.textContent = "MicroAI";
    const version = document.createElement("span");
    version.textContent = "BTM-1.1.5 Nova";
    landing.append(title, version);
    chat.appendChild(landing);
    updateChatSize();
    return;
  }

  for (const [index, message] of session.messages.entries()) {
    const div = document.createElement("div");
    div.className = "msg " + (message.role === "user" ? "user" : "ai");

    if (message.role === "ai" && message.code) {
      const previewButton = document.createElement("button");
      previewButton.className = "code-preview-btn";
      previewButton.textContent = tr("preview");
      previewButton.addEventListener("click", () => {
        openCodePreview(message.code.source, message.code.language);
      });
      div.appendChild(previewButton);
    }

    const content = document.createElement("div");
    content.textContent = message.text;
    div.appendChild(content);

    const actions = document.createElement("div");
    actions.className = "message-actions";
    const copyButton = document.createElement("button");
    copyButton.type = "button";
    copyButton.className = "secondary";
    copyButton.textContent = tr("copyMessage");
    copyButton.addEventListener("click", async () => {
      if (await copyMessageText(message.text)) {
        copyButton.textContent = "✓";
        setTimeout(() => { copyButton.textContent = tr("copyMessage"); }, 1000);
      }
    });
    actions.appendChild(copyButton);

    if (message.role === "user") {
      div.tabIndex = 0;
      const editButton = document.createElement("button");
      editButton.type = "button";
      editButton.className = "secondary";
      editButton.textContent = tr("editCommand");
      editButton.addEventListener("click", () => {
        $("prompt").value = message.text;
        session.messages.splice(index);
        saveCurrentSession();
        renderChat();
        $("prompt").focus();
      });
      actions.appendChild(editButton);

      let holdTimer;
      div.addEventListener("pointerdown", event => {
        if (event.target.closest("button")) return;
        holdTimer = setTimeout(() => div.classList.add("actions-visible"), 500);
      });
      for (const eventName of ["pointerup", "pointerleave", "pointercancel"]) {
        div.addEventListener(eventName, () => clearTimeout(holdTimer));
      }
      div.addEventListener("contextmenu", event => {
        event.preventDefault();
        div.classList.add("actions-visible");
      });
    }

    div.appendChild(actions);
    chat.appendChild(div);
  }

  chat.scrollTop = chat.scrollHeight;
  updateChatSize();
}

