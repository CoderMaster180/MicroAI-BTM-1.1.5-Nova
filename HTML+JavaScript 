$("form").addEventListener("submit", event => {
  event.preventDefault();

  const original = $("prompt").value.trim();
  if (!original) return;

  const sessionBeforeFirstMessage = currentSession();
  if (sessionBeforeFirstMessage && !sessionBeforeFirstMessage.messages.length) {
    addMessage("ai", tr("sessionWelcome"));
  }
  addMessage("user", original);
  $("prompt").value = "";

  const normalized = normalize(original);
  const plainOriginal = original.toLocaleLowerCase(locale())
    .replace(/[.,!?;:()[\]"“”{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  if (normalized !== plainOriginal && !isEmojiOnly(original)) {
    addMessage("ai", appSettings.language === "en"
      ? "📝 I interpreted your message with a few spelling corrections: " + normalized
      : "📝 Bazı yazımları düzelterek yorumladım: " + normalized);
  }

  const result = respond(original);
  const session = currentSession();
  if (session && lastTopic) {
    session.topic = lastTopic;
    saveCurrentSession();
  }
  addMessage("ai", result.text, result.code);
});

/* Emoji panel */

const emojis = [
  "😀","😃","😄","😁","😂","🤣","😊","🙂",
  "😉","😍","🥰","😎","🤔","😢","😭","🥳",
  "👍","👎","👏","🙏","🙌","❤️","💙","🔥",
  "⭐","🎉","🤖","🧠","💻","🐍","👋","👌",
  "💡","🚀"
];

for (const emoji of emojis) {
  const button = document.createElement("button");
  button.type = "button";
  button.textContent = emoji;
  button.addEventListener("click", () => {
    $("prompt").value += emoji;
    $("prompt").focus();
  });
  $("emojiPanel").appendChild(button);
}

$("emojiToggle").addEventListener("click", () => {
  const panel = $("emojiPanel");
  panel.style.display = panel.style.display === "flex" ? "none" : "flex";
});

/* Interface buttons */

$("newChat").addEventListener("click", newSession);
$("showArchives").addEventListener("click", () => showView("archives"));
$("showSettings").addEventListener("click", () => showView("settings"));
$("settingsBackToChat").addEventListener("click", () => showView("chat"));
$("backToChat").addEventListener("click", () => showView("chat"));
$("showAbout").addEventListener("click", () => showView("about"));
$("aboutBackToChat").addEventListener("click", () => showView("settings"));

function setLanguage(language) {
  const currentDefaults = defaultTrainingText(appSettings.language);
  const targetDefaults = defaultTrainingText(language);
  const isUsingDefaults = $("data").value.trim() === currentDefaults.join("\n");
  appSettings.language = language;
  if (isUsingDefaults) $("data").value = targetDefaults.join("\n");
  train(false);
  saveAppSettings();
  applySettings();
}

$("languageSetting").addEventListener("change", event => setLanguage(event.target.value));
$("themeSetting").addEventListener("change", event => {
  appSettings.theme = event.target.value;
  saveAppSettings();
  applySettings();
});
$("autoSaveSetting").addEventListener("change", event => {
  appSettings.autoSave = event.target.checked;
  saveAppSettings();
  if (appSettings.autoSave) persistSessions();
});
$("aboutBackToChat").addEventListener("click", () => showView("chat"));

$("clearCurrent").addEventListener("click", () => {
  if (confirm(tr("clearConfirm"))) {
    newSession();
  }
});

$("train").addEventListener("click", () => train(true));

$("addExample").addEventListener("click", () => {
  const example = prompt(tr("addExamplePrompt"));

  if (example && example.trim()) {
    $("data").value += "\n" + example.trim();
    writeStore(KEYS.training, $("data").value);
    addMessage("ai", tr("exampleAdded"));
  }
});

$("resetTraining").addEventListener("click", () => {
  if (!confirm(tr("resetConfirm"))) return;
  $("data").value = defaultTrainingText(appSettings.language).join("\n");
  train(true);
});

$("savePreferences").addEventListener("click", savePreferences);
$("forgetPreferences").addEventListener("click", forgetPreferences);

/* Startup */

function startup() {
  const savedSettings = loadJSON(KEYS.settings, {});
  appSettings.language = ["en", "tr", "de", "fr", "it", "es", "ru", "ar", "pt", "la", "ja"].includes(savedSettings.language) ? savedSettings.language : "en";
  appSettings.theme = savedSettings.theme === "light" ? "light" : "dark";
  appSettings.autoSave = typeof savedSettings.autoSave === "boolean" ? savedSettings.autoSave : true;

  const savedTraining = readStore(KEYS.training);
  const defaultCorpus = defaultTrainingText(appSettings.language);
  if (savedTraining === null) {
    $("data").value = defaultCorpus.join("\n");
  } else {
    const existingLines = savedTraining.split(/\r?\n/);
    const languageOrder = ["en", "tr", "de", "fr", "it", "es", "ru", "ar", "pt", "la", "ja"];
    const legacyGeneratedLines = Object.entries(sharedTemplates).flatMap(([language, templates]) => {
      const languageIndex = languageOrder.indexOf(language);
      return sharedTopics.flatMap(topic => templates.map(template =>
        template.replaceAll("{topic}", topic[languageIndex < 0 ? 0 : languageIndex])
      ));
    });
    const builtInLines = new Set([
      ...expandedInitialText, ...expandedEnglishText,
      ...expandedRussianText, ...expandedArabicText,
      ...portugueseTrainingText, ...latinTrainingText, ...japaneseTrainingText,
      ...extraTurkishTrainingCorpus,
      ...["en", "tr", "de", "fr", "it", "es", "ru", "ar", "pt", "la", "ja"].flatMap(defaultTrainingText),
      ...legacyGeneratedLines
    ].map(normalize));
    const customLines = existingLines.filter(line => !builtInLines.has(normalize(line)));
    $("data").value = [...customLines, ...defaultCorpus].join("\n");
  }

  applySettings();

  const saved = loadJSON(KEYS.sessions, []);
  sessions = Array.isArray(saved)
    ? saved.filter(s => s && typeof s.id === "string" && Array.isArray(s.messages))
    : [];

  for (const session of sessions) {
    session.title = typeof session.title === "string" ? session.title : "İsimsiz sohbet";
    session.created = Number(session.created) || Date.now();
    session.updated = Number(session.updated) || session.created;

    session.messages = session.messages.filter(m => m && typeof m.text === "string");
    for (const message of session.messages) {
      if (message.role !== "user") message.role = "ai";
    }
  }

  loadPreferences();
  train(false);

  // Show an empty landing area on first load instead of a welcome message.
  newSession(false);

  $("archiveCount").textContent = sessions.length;

  if (!storageOK) {
    $("status").textContent = appSettings.language === "en"
      ? "MicroAI is running; browser storage may be unavailable."
      : "MicroAI çalışıyor; tarayıcı depolaması kullanılamıyor olabilir.";
  }
}

startup();
</script>
