function editDistanceAtMostOne(a, b) {
  if (Math.abs(a.length - b.length) > 1 || a === b) return a === b ? 0 : 2;
  let i = 0, j = 0, edits = 0;
  while (i < a.length && j < b.length) {
    if (a[i] === b[j]) { i++; j++; continue; }
    if (++edits > 1) return 2;
    if (a.length === b.length && i + 1 < a.length &&
        a[i] === b[j + 1] && a[i + 1] === b[j]) {
      i += 2;
      j += 2;
    } else if (a.length > b.length) i++;
    else if (b.length > a.length) j++;
    else { i++; j++; }
  }
  if (i < a.length || j < b.length) edits++;
  return edits;
}

function correctWord(word) {
  if (corrections[word]) return corrections[word];
  if (word.length < 5) return word;
  if (correctionCache.has(word)) return correctionCache.get(word);

  for (let length = word.length - 1; length <= word.length + 1; length++) {
    const candidates = correctionCandidatesByLength.get(length) || [];
    for (const candidate of candidates) {
      if (editDistanceAtMostOne(word, candidate) === 1) {
        correctionCache.set(word, candidate);
        return candidate;
      }
    }
  }

  correctionCache.set(word, word);
  return word;
}

function normalize(text) {
  const currentLocale = locale();
  let normalized = String(text).toLocaleLowerCase(currentLocale).normalize("NFC");
  if (["en", "tr"].includes(appSettings.language)) {
    normalized = normalized.replace(/[a-zçğıöşüı]+/gi, word => correctWord(word.toLocaleLowerCase(currentLocale)));
  }
  return normalized
    .replace(/[.,!?;:()[\]"“”{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function tokenize(text) {
  return normalize(text).split(" ").filter(Boolean);
}

function hasAny(text, list) {
  return list.some(phrase => text.includes(phrase));
}

