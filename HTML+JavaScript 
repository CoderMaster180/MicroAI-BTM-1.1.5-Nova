function train(showNotice = true) {
  transitions = new Map();
  vocabulary = new Set();

  trainingLines = $("data").value
    .split(/\n|[.!?]+/)
    .map(s => s.trim())
    .filter(Boolean)
    .map(original => ({ original, words: tokenize(original) }))
    .filter(line => line.words.length >= 2);

  function add(context, next) {
    const key = context.join(" ");
    if (!transitions.has(key)) transitions.set(key, new Map());
    const options = transitions.get(key);
    options.set(next, (options.get(next) || 0) + 1);
  }

  for (const line of trainingLines) {
    const words = line.words;
    words.forEach(word => vocabulary.add(word));
    add(["<başla>"], words[0]);

    for (let i = 0; i < words.length; i++) {
      const next = i + 1 < words.length ? words[i + 1] : "<bitir>";
      add([words[i]], next);

      if (i > 0) add(words.slice(i - 1, i + 1), next);
    }
  }

  correctionCandidatesByLength = new Map();
  for (const word of new Set([...correctionWords, ...vocabulary])) {
    if (!correctionCandidatesByLength.has(word.length)) {
      correctionCandidatesByLength.set(word.length, []);
    }
    correctionCandidatesByLength.get(word.length).push(word);
  }
  correctionCache.clear();

  $("sentenceCount").textContent = trainingLines.length;
  $("wordCount").textContent = countEnglishTrainingWords();

  writeStore(KEYS.training, $("data").value);
  $("status").dataset.ready = "true";
  $("status").textContent = storageOK
    ? ((translations[appSettings.language] || translations.en).ready || "MicroAI is ready · BTM-1.1.5 Nova")
    : (appSettings.language === "tr" ? "MicroAI çalışıyor; tarayıcı kayıtları kullanılamayabilir." : "MicroAI is running; browser storage may be unavailable.");

  if (showNotice && currentSession()) {
    addMessage("ai", appSettings.language === "en"
      ? "Training complete! 📚\n" + trainingLines.length + " sentences and " + vocabulary.size + " unique words processed."
      : "Eğitim tamamlandı! 📚\n" + trainingLines.length + " cümle ve " + vocabulary.size + " farklı kelime işlendi.");
  }
}

function overlapScore(a, b) {
  const A = new Set(tokenize(a));
  const B = new Set(tokenize(b));
  if (!A.size || !B.size) return 0;

  let common = 0;
  for (const word of A) if (B.has(word)) common++;

  // Account for both set sizes so very short sentences are not overly favored.

  return common / Math.sqrt(A.size * B.size);
}

function bestMatchingSentence(text) {
  const stopWords = {
    en: new Set(["a", "an", "the", "is", "are", "i", "you", "to", "of", "and", "what", "how", "can", "do"]),
    tr: new Set(["bir", "ve", "ile", "için", "bu", "şu", "ben", "sen", "ne", "nasıl", "mi", "mı", "mu", "mü"]),
    ru: new Set(["и", "в", "на", "я", "ты", "это", "что", "как", "а", "для", "с"]),
    ar: new Set(["في", "من", "على", "إلى", "عن", "هذا", "هذه", "ما", "كيف", "هل", "و"])
  };
  const stop = stopWords[appSettings.language] || new Set();
  const query = new Set(tokenize(text).filter(word => !stop.has(word)));
  if (!query.size) return null;

  const documentFrequency = new Map();
  for (const line of trainingLines) {
    for (const word of new Set(line.words)) {
      documentFrequency.set(word, (documentFrequency.get(word) || 0) + 1);
    }
  }
  const weight = word => Math.log(1 + (trainingLines.length + 1) / ((documentFrequency.get(word) || 0) + 1));
  const queryWeight = [...query].reduce((sum, word) => sum + weight(word), 0);
  let best = null;
  let bestScore = 0;

  for (const line of trainingLines) {
    const lineWords = new Set(line.words);
    let sharedWeight = 0;
    let lineWeight = 0;
    for (const word of lineWords) lineWeight += weight(word);
    for (const word of query) if (lineWords.has(word)) sharedWeight += weight(word);

    const score = sharedWeight / Math.sqrt(queryWeight * lineWeight || 1);
    if (score > bestScore) {
      best = line;
      bestScore = score;
    }
  }

  return best && bestScore >= 0.34 ? { line: best, score: bestScore } : null;
}

function weightedChoice(options) {
  if (!options || !options.size) return null;

  const entries = [...options.entries()];
  const total = entries.reduce((sum, item) => sum + item[1], 0);
  let r = Math.random() * total;

  for (const [word, count] of entries) {
    r -= count;
    if (r < 0) return word;
  }

  return entries[entries.length - 1][0];
}

function generateText(seed, limit = 8) {
  const output = tokenize(seed);
  if (!output.length) return "";

  for (let i = 0; i < limit; i++) {
    let options = output.length >= 2
      ? transitions.get(output.slice(-2).join(" "))
      : null;

    if (!options || !options.size) {
      options = transitions.get(output[output.length - 1]);
    }

    const next = weightedChoice(options);
    if (!next || next === "<bitir>" || next === "<başla>") break;
    output.push(next);
  }

  return output.join(" ");
}

