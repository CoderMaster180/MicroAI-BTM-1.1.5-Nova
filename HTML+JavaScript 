  const curated = (curatedTrainingExamples[language] || curatedTrainingExamples.en)
    .trim().split(/\n+/).map(sentence => sentence.trim()).filter(Boolean);
  if (language === "tr") {
    return [...curated, ...diverseTurkishTrainingCorpus, ...extraTurkishTrainingCorpus];
  }
  return [...curated, ...buildSharedTrainingText(language)].slice(0, 1032);
}

