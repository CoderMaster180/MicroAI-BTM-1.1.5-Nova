function respond(original) {
  const t = normalize(original);
  const intent = classify(original);
  let answer = "";
  let code = null;

  if (isEmojiOnly(original)) {
    return appSettings.language === "en"
      ? { text: "😊 I saw your emoji! What would you like to talk about?", code: null }
      : { text: emojiResponse(original), code: null };
  }

  // Commands that modify memory
  if (intent === "remember") {
    const match = appSettings.language === "en"
      ? original.match(/remember\s*:\s*(.+)/i)
      : original.match(/hatırla\s*:\s*(.+)/i) || original.match(/hatirla\s*:\s*(.+)/i);

    if (match && rememberFact(match[1])) {
      answer = "Tamam! 🧠 Şunu hafızama kaydettim:\n“" + match[1].trim() + "”";
    } else {
      answer = "Bu bilgiyi kaydedemedim. Farklı bir cümle deneyebilir misin?";
    }

    lastIntent = intent;
    return localizedAnswer(answer, intent, null);
  }

  if (intent === "forget") {
    if (appSettings.language === "en" ? hasAny(t, ["forget all"]) : hasAny(t, ["hepsini unut"])) {
      forgetFact("");
      answer = "Kayıtlı notların tamamını sildim. 🧹";
    } else {
      const match = appSettings.language === "en"
        ? original.match(/forget\s*:\s*(.+)/i)
        : original.match(/unut\s*:\s*(.+)/i);
      if (match) {
        forgetFact(match[1]);
        answer = "Bu ifadeyle eşleşen notları sildim.";
      } else {
        answer = "Belirli bir notu silmek için “Bunu unut: Minecraft” gibi yazabilirsin. Tüm notları silmek için “Hepsini unut” yaz.";
      }
    }

    lastIntent = intent;
    return localizedAnswer(answer, intent, null);
  }

  if (intent === "memory") {
    answer = preferences.facts
      ? "Hafızamdaki notlar:\n" + preferences.facts
      : "Henüz kayıtlı bir notun yok. “Hatırla: En sevdiğim oyun Minecraft” yazarak deneyebilirsin.";

    lastIntent = intent;
    return localizedAnswer(answer, intent, null);
  }

  switch (intent) {
    case "greeting":
      answer = "Merhaba" + (preferences.nickname ? " " + preferences.nickname : "") +
        "! 😊 Bugün ne konuşalım?";
      lastTopic = "greeting";
      break;

    case "thanks":
      answer = "Rica ederim" + (preferences.nickname ? " " + preferences.nickname : "") +
        "! 😊 Başka bir konuda yardımcı olabilir miyim?";
      break;

    case "feeling":
      answer = "Ben bir programım, insanlar gibi hissetmiyorum. 😊 Ama buradayım ve seninle sohbet etmeye hazırım! Sen nasılsın?";
      lastTopic = "feeling";
      break;

    case "identity":
      answer = "Ben MicroAI'nin BTM-1.1.5 Nova  sürümüyüm! 🤖 Bağlam takibi, kural tabanlı niyet algılama, basit metin eşleştirme ve temel kod örnekleri sunan deneysel bir Türkçe sohbet projesiyim.";
      lastTopic = "identity";
      break;

    case "capabilities":
      answer = "Şu anda yapabildiklerim:\n" +
        "• Selamlaşma ve temel sohbet\n" +
        "• Önceki konuyu takip etmeye çalışma\n" +
        "• Eğitim cümleleriyle benzerlik eşleştirme\n" +
        "• Basit yazım düzeltmeleri ve emoji tepkileri\n" +
        "• Bazı Python örnekleri üretme\n" +
        "• HTML sayfası oluşturma ve önizleme\n" +
        "• Sohbet arşivi ve kişisel hafıza\n\n" +
        "Henüz genel amaçlı, büyük bir dil modeli değilim.";
      break;

    case "goodbye":
      answer = "Görüşürüz" + (preferences.nickname ? " " + preferences.nickname : "") +
        "! 👋 Sohbetin arşivde kalacak.";
      break;

    case "ai":
      answer = "Yapay zeka, bilgisayarların öğrenme, örüntü tanıma ve problem çözme gibi görevleri yerine getirmesini sağlayan yöntemlerin genel adıdır. Ben daha basit bir örneğim: kurallar, metin eşleştirme ve kelime ilişkilerinden yararlanıyorum.";
      lastTopic = "ai";
      break;

    case "pythonInfo":
      answer = "Python, okunması görece kolay bir programlama dilidir. Değişkenler, koşullar, döngüler ve fonksiyonlarla programlar yazabilirsin. 🐍 İstersen basit bir Python örneği de hazırlayabilirim.";
      lastTopic = "python";
      break;

    case "pythonCode": {
      const result = pythonResponse(t);

      if (result) {
        code = { source: result.source, language: result.language };
        answer = result.description + "\n\n" + result.source;
      } else {
        answer = "Tabii, Python kodu yazabilirim! 🐍 Nasıl bir program istediğini söyler misin?\n\nÖrnekler: hesap makinesi, sayı tahmin oyunu, asal sayı kontrolü, yapılacaklar listesi veya sıcaklık dönüştürücü. İstersen kendi fikrini de yazabilirsin.";
      }

      lastTopic = "python";
      break;
    }

    case "htmlCode":
      code = htmlResponse();
      answer = code.description + "\n\n" + code.source;
      lastTopic = "html";
      break;

    case "emotion":
      answer = "Bunu yaşadığına üzüldüm. 💙 İstersen neler olduğunu anlatabilirsin. Seni dikkatle dinlemeye çalışırım.";
      lastTopic = "emotion";
      break;

    case "followup": {
      const previous = previousUserMessage(currentSession());
      const reference = previous ? " Önceki isteğin: “" + previous.slice(0, 100) + "”." : "";

      if (lastTopic === "python") {
        answer = "Python konusuna devam edelim! 🐍" + reference +
          " Hangi kısmı merak ediyorsun? İstersen az önceki kodu adım adım açıklayabilir veya üzerinde değişiklik yapabilirim.";
      } else if (lastTopic === "html") {
        answer = "Web sayfası konusuna devam edelim. 🌐" + reference +
          " Renklerini, başlığını, düğmelerini veya içeriğini birlikte değiştirebiliriz.";
      } else if (lastTopic === "ai") {
        answer = "Yapay zeka konusuna devam edelim." + reference +
          " Hangi bölümünü daha ayrıntılı açıklamamı istersin?";
      } else if (lastTopic === "emotion") {
        answer = "Buradayım. 💙 İstersen biraz daha anlat; acele etmene gerek yok.";
      } else {
        answer = previous
          ? "Önceki mesajındaki “" + previous.slice(0, 100) + "” konusunu mu kastediyorsun? Biraz daha ayrıntı verir misin?"
          : "Hangi konuyu kastettiğini tam çıkaramadım. Biraz daha ayrıntı verebilir misin?";
      }
      break;
    }

    case "question": {
      // Find the closest training sentence instead of returning a greeting or a generic response.
      const match = bestMatchingSentence(original);

      if (match) {
        answer = "Eğitim verilerimdeki en yakın cümle şu:\n\n“" +
          match.line.original +
          "”\n\nBu cümle sorunun kesin cevabı olmayabilir.";
      } else {
        answer = "Bu sorunun cevabını mevcut bilgilerimle güvenilir şekilde belirleyemiyorum. 🤔 Biraz daha ayrıntı verebilir misin?";
      }
      break;
    }

    default: {
      const memoryQuery = hasAny(t, [
        "en sevdiğim oyun", "en sevdigim oyun", "ne seviyorum",
        "hangi oyunu seviyorum", "hangi oyundu"
      ]);

      if (memoryQuery && preferences.facts) {
        answer = "Kayıtlı notlarına bakabilirim:\n" + preferences.facts;
        break;
      }

      const match = bestMatchingSentence(original);

      if (match) {
        answer = "Bu mesajına en yakın eğitim cümlesi:\n\n“" +
          match.line.original + "”";

        if (match.score > 0.8) {
          answer += "\n\nBu cümleyle oldukça fazla ortak kelime var.";
        }
      } else {
        const words = tokenize(original);
        const knownCount = words.filter(w => vocabulary.has(w)).length;

        if (knownCount >= 2) {
          const generated = generateText(original, 4);
          answer = generated
            ? "Kelime örüntülerimden bir metin oluşturdum:\n\n" +
              generated +
              "\n\n_Not: Bu, anlamlı veya doğru bir cevap olmayabilir._"
            : "Bu mesajı henüz anlayamadım. Biraz daha açık anlatabilir misin? 😊";
        } else {
          answer = "Ne demek istediğini tam anlayamadım" +
            (preferences.nickname ? ", " + preferences.nickname : "") +
            ". 😊 Başka kelimelerle anlatmayı deneyebilir misin?";
        }
      }
    }
  }

  // Reduce consecutive repetition of the same response.
  if (recentReplies.slice(-3).includes(answer) && !code) {
    const alternatives = {
      greeting: "Selam tekrar! 😊 Başka ne konuşalım?",
      thanks: "Ne demek! Başka bir şeye bakalım mı? 😊",
      feeling: "Ben yine buradayım! 😊 Senin günün nasıl geçiyor?",
      question: "Bu soruya henüz net bir cevap bulamadım. Biraz daha ayrıntı verebilir misin?",
      general: "Seni farklı bir şekilde anlamaya çalışayım. Biraz daha ayrıntı verebilir misin?"
    };

    answer = alternatives[intent] || "İstersen konuyu başka bir açıdan ele alalım. 😊";
  }

  recentReplies.push(answer);
  if (recentReplies.length > 12) recentReplies.shift();

  lastIntent = intent;

  return localizedAnswer(answer, intent, code);
}

