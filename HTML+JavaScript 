    const item = document.createElement("div");
    item.className = "archive-item";

    const open = document.createElement("button");
    open.className = "archive-open";

    const title = document.createElement("div");
    title.className = "archive-title";
    title.textContent = session.title || (appSettings.language === "en" ? "Untitled chat" : "İsimsiz sohbet");

    const preview = document.createElement("div");
    preview.className = "archive-preview";
    const last = session.messages[session.messages.length - 1];
    preview.textContent = formatDate(session.updated) + " · " +
      formatBytes(sessionBytes(session)) + " · " +
      (last ? last.text.slice(0, 80) : (appSettings.language === "en" ? "Empty chat" : "Boş sohbet"));

    open.append(title, preview);
    open.addEventListener("click", () => {
      currentId = session.id;
      recentReplies = [];
      lastTopic = inferSessionTopic(session);
      lastIntent = "";
      showView("chat");
    });

    const rename = document.createElement("button");
    rename.className = "secondary";
    rename.textContent = tr("rename");
    rename.addEventListener("click", () => {
      const name = prompt(tr("renamePrompt"), session.title);
      if (name && name.trim()) {
        session.title = name.trim().slice(0, 80);
        persistSessions();
        renderArchives();
      }
    });

    const del = document.createElement("button");
    del.className = "danger";
    del.textContent = tr("delete");
    del.addEventListener("click", () => {
      if (!confirm(tr("deleteConfirm"))) return;

      sessions = sessions.filter(s => s.id !== session.id);
      if (currentId === session.id) currentId = null;
      persistSessions();

      if (!sessions.length) newSession();
      else {
        if (!currentId) currentId = sessions[0].id;
        renderArchives();
      }
    });

    item.append(open, rename, del);
    list.appendChild(item);
  }
}

/* User memory */

function loadPreferences() {
  const saved = loadJSON(KEYS.preferences, {});
  preferences = {
    nickname: typeof saved.nickname === "string" ? saved.nickname : "",
    facts: typeof saved.facts === "string" ? saved.facts : ""
  };
  $("nickname").value = preferences.nickname;
  $("userFacts").value = preferences.facts;
}

function savePreferences() {
  preferences = {
    nickname: $("nickname").value.trim().slice(0, 60),
    facts: $("userFacts").value.trim().slice(0, 1500)
  };

  if (writeStore(KEYS.preferences, JSON.stringify(preferences))) {
    addMessage("ai", appSettings.language === "en" ? "Your preferences have been saved! 💾" : "Tercihlerin kaydedildi! 💾");
  } else {
    addMessage("ai", appSettings.language === "en" ? "Browser settings prevented saving your preferences." : "Tarayıcı ayarları nedeniyle tercihler kaydedilemedi.");
  }
}

function forgetPreferences() {
  if (!confirm(tr("forgetConfirm"))) return;

  preferences = { nickname: "", facts: "" };
  $("nickname").value = "";
  $("userFacts").value = "";
  writeStore(KEYS.preferences, JSON.stringify(preferences));
  addMessage("ai", appSettings.language === "en" ? "User preferences were cleared." : "Kullanıcı tercihleri silindi.");
}

function rememberFact(text) {
  const fact = text.trim().slice(0, 300);
  if (!fact) return false;

  const facts = preferences.facts
    .split("\n")
    .map(s => s.trim())
    .filter(Boolean);

  if (facts.some(f => normalize(f) === normalize(fact))) return false;

  facts.push(fact);
  preferences.facts = facts.join("\n").slice(-1500);
  $("userFacts").value = preferences.facts;
  writeStore(KEYS.preferences, JSON.stringify(preferences));
  return true;
}

function forgetFact(text) {
  const query = normalize(text);
  if (!query) {
    preferences.facts = "";
  } else {
    preferences.facts = preferences.facts
      .split("\n")
      .filter(f => !normalize(f).includes(query))
      .join("\n");
  }

  $("userFacts").value = preferences.facts;
  writeStore(KEYS.preferences, JSON.stringify(preferences));
}

function nicknamePrefix() {
  const name = preferences.nickname.trim();
  return name ? name + ", " : "";
}

