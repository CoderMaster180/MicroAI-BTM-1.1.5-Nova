/* Safe, separate code preview tab */

function openCodePreview(code, language) {
  const escaped = code.replace(/&/g, "&amp;")
    .replace(/</g, "&lt;").replace(/>/g, "&gt;");

  let page;

  if (language === "html") {
    const safeJSON = JSON.stringify(code).replace(/</g, "\\u003c");

    page = `<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MicroAI · ${appSettings.language === "en" ? "HTML Preview" : "HTML Önizleme"}</title>
<style>
body{margin:0;background:#10131b;color:#f1f5f9;font:15px system-ui}
header{padding:14px;background:#1b2130}
main{padding:12px}
iframe{width:100%;height:65vh;background:white;border:1px solid #394154;border-radius:10px}
pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#1b2130;padding:12px;border-radius:8px}
</style>
</head>
<body>
<header><h2>MicroAI · ${appSettings.language === "en" ? "HTML Preview" : "HTML Önizleme"}</h2>
<div>${appSettings.language === "en" ? "Isolated preview area" : "İzole edilmiş önizleme alanı"}</div></header>
<main>
<iframe id="preview" sandbox="allow-scripts" title="${appSettings.language === "en" ? "HTML preview" : "HTML önizlemesi"}"></iframe>
<details><summary>${appSettings.language === "en" ? "Show source code" : "Kaynak kodu göster"}</summary><pre>${escaped}</pre></details>
</main>
<script>
document.getElementById("preview").srcdoc = ${safeJSON};
<\/script>
</body>
</html>`;
  } else {
    page = `<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MicroAI · ${appSettings.language === "en" ? "Code Viewer" : "Kod Görüntüleyici"}</title>
<style>
body{margin:0;padding:18px;background:#10131b;color:#f1f5f9;font:15px system-ui}
pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#1b2130;border:1px solid #394154;padding:14px;border-radius:10px}
.note{color:#aab4c8}
</style>
</head>
<body>
<h2>MicroAI · ${appSettings.language === "en" ? "Code Viewer" : "Kod Görüntüleyici"}</h2>
<p class="note">${appSettings.language === "en" ? "Language" : "Dil"}: ${language}. ${appSettings.language === "en" ? "This code is not executed here." : "Bu kod bu sayfada çalıştırılmaz."}</p>
<pre>${escaped}</pre>
</body>
</html>`;
  }

  const url = URL.createObjectURL(new Blob([page], {
    type: "text/html;charset=utf-8"
  }));

  const tab = window.open(url, "_blank");

  if (!tab) {
    URL.revokeObjectURL(url);
    alert("Sekme açılamadı. Açılır pencere iznini kontrol et.");
    return;
  }

  setTimeout(() => URL.revokeObjectURL(url), 60000);
}

